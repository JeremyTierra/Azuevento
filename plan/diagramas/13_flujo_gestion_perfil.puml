@startuml Flujo_Gestion_Perfil
skinparam activityBackgroundColor #FEFECE
skinparam activityBorderColor #A80036
skinparam activityDiamondBackgroundColor #FEFECE
skinparam activityDiamondBorderColor #A80036
skinparam arrowColor #A80036

title Diagrama de Actividades - Gestion de Perfil de Usuario

|Usuario|
start

:Acceder a seccion "Perfil";

|Sistema|
:Cargar datos del usuario actual;
:Mostrar información del perfil;

|Usuario|
:Visualizar perfil;
note right
  Informacion mostrada:
  * Nombre
  * Email
  * Descripcion
  * Intereses (categorias)
  * Foto de perfil
end note

fork

partition "Editar Perfil" #LightYellow {
    :Seleccionar "Editar perfil";

    |Sistema|
    :Cargar formulario con datos actuales;

    |Usuario|
    :Modificar campos deseados;
    note right
      Campos editables:
      * Nombre
      * Telefono
      * Descripcion
      * Foto de perfil
    end note

    :Guardar cambios;

    |Sistema|
    :Validar datos de entrada;

    if (¿Datos validos?) then (si)
        :Actualizar registro en base de datos;
        :Retornar perfil actualizado;

        |Usuario|
        :Mostrar confirmacion de exito;
        :Actualizar vista del perfil;
    else (no)
        |Usuario|
        :Mostrar errores de validacion;
        :Corregir datos;
    endif
}

fork again

partition "Gestionar Intereses" #LightBlue {
    :Acceder a seleccion de intereses;

    |Sistema|
    :Cargar lista de categorias;
    :Marcar categorias ya seleccionadas;

    |Usuario|
    :Seleccionar/deseleccionar categorias;
    :Confirmar seleccion;

    |Sistema|
    :Actualizar tabla user_interests;
    :Sincronizar intereses del usuario;

    |Usuario|
    :Mostrar intereses actualizados;
}

fork again

partition "Cambiar Contrasena" #LightGreen {
    :Seleccionar "Cambiar contrasena";

    |Sistema|
    :Mostrar formulario de cambio;

    |Usuario|
    :Ingresar contrasena actual;
    :Ingresar nueva contrasena;
    :Confirmar nueva contrasena;
    :Enviar solicitud;

    |Sistema|
    :Verificar contrasena actual;

    if (¿Contrasena actual correcta?) then (si)
        :Validar nueva contrasena;

        if (¿Nueva contrasena valida?) then (si)
            if (¿Coinciden las contrasenas?) then (si)
                :Encriptar nueva contrasena (BCrypt);
                :Actualizar password_hash;

                |Usuario|
                :Mostrar confirmacion de exito;
            else (no)
                |Usuario|
                :Mostrar error\n"Las contrasenas no coinciden";
            endif
        else (no)
            |Usuario|
            :Mostrar requisitos de contrasena;
        endif
    else (no)
        |Usuario|
        :Mostrar error\n"Contrasena actual incorrecta";
    endif
}

fork again

partition "Cerrar Sesion" #LightPink {
    :Seleccionar "Cerrar sesion";

    |Sistema|
    :Eliminar token JWT almacenado;
    :Limpiar estado de autenticacion;

    |Usuario|
    :Redirigir a pantalla de login;
}

end fork

stop

@enduml
